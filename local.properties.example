## Local properties template — copy to local.properties and fill in.
## local.properties is gitignored, so it never leaves your machine.

## Android SDK location. Windows example:
# sdk.dir=C\:\\Users\\YOURNAME\\AppData\\Local\\Android\\Sdk
# macOS / Linux:
# sdk.dir=/Users/YOURNAME/Library/Android/sdk

## OpenAI API key (for smart bill extraction). Optional — the on-device
## parser is the always-on fallback.
# openai.api.key=sk-proj-xxxxxxxxxxxx
# openai.model=gpt-4o

## Paddle Premium subscription.
## The app opens `paddle.pricing.url` in a Chrome Custom Tab. That page
## hosts the Paddle.js inline checkout; after a successful payment the
## page fires expenselens://premium-callback?status=success and the app
## unlocks Premium locally.
##
## Paddle Billing v2 does NOT support hosted checkout URLs for native
## mobile apps. See PADDLE_SETUP.md for the full setup walkthrough.
# paddle.product.id=pro_xxxxxxxxxxxxxxxxxxxxxx
# paddle.price.id=pri_xxxxxxxxxxxxxxxxxxxxxx
# paddle.pricing.url=https://prasannaverse13.github.io/pricing.html
# paddle.price.usd=4.99
# paddle.portal.url=
